  "entries": [
    {
      "entry_id": "dtjy-v1-jia-verse",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "甲木",
      "day_stem": "甲",
      "kind": "verse",
      "original_text": "甲木參天，胞胎要火，春不容金，秋不容土，火熾乘龍，水蕩騎虎，地潤天和，植立千古。",
      "page": 8,
      "source_chunk_id": "DT2-0008",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-jia-annotation_excerpt",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "甲木",
      "day_stem": "甲",
      "kind": "annotation_excerpt",
      "original_text": "甲為根幹之木，純陽之本，參天雄壯",
      "page": 8,
      "source_chunk_id": "DT2-0008",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-yi-verse",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "乙木",
      "day_stem": "乙",
      "kind": "verse",
      "original_text": "乙木雖柔，刲羊解牛，懷丁抱丙，跨雞乘猴，虛濕之地，騎馬亦憂，藤蘿繫甲，可春可秋。",
      "page": 9,
      "source_chunk_id": "DT2-0009",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-yi-annotation_excerpt",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "乙木",
      "day_stem": "乙",
      "kind": "annotation_excerpt",
      "original_text": "乙為枝葉之木，柔如花卉",
      "page": 9,
      "source_chunk_id": "DT2-0009",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-bing-verse",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "丙火",
      "day_stem": "丙",
      "kind": "verse",
      "original_text": "丙火猛烈，欺霜侮雪，能煆庚金，逄辛反怯，土眾成慈，水猖顯節，虎馬犬鄉，甲來焚滅。",
      "page": 10,
      "source_chunk_id": "DT2-0010",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-bing-annotation_excerpt",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "丙火",
      "day_stem": "丙",
      "kind": "annotation_excerpt",
      "original_text": "丙為焚烈之火，純陽之性",
      "page": 10,
      "source_chunk_id": "DT2-0010",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-ding-verse",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "丁火",
      "day_stem": "丁",
      "kind": "verse",
      "original_text": "丁火柔中，內性昭融，抱乙而孝，合壬而忠，旺而不烈，衰而不窮，如有嫡母，可秋可冬。",
      "page": 10,
      "source_chunk_id": "DT2-0011",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-ding-annotation_excerpt",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "丁火",
      "day_stem": "丁",
      "kind": "annotation_excerpt",
      "original_text": "丁為溫煖之火，其性雖烈而屬陰，則柔而得其中矣，外柔順而內文明，豈不昭融乎",
      "page": 10,
      "source_chunk_id": "DT2-0011",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-wu-verse",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "戊土",
      "day_stem": "戊",
      "kind": "verse",
      "original_text": "戊土固重，既中且正，靜翕動闢，萬物司命，水旺物生，火燥喜潤，若在坤艮，怕沖宜靜。",
      "page": 11,
      "source_chunk_id": "DT2-0012",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-wu-annotation_excerpt",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "戊土",
      "day_stem": "戊",
      "kind": "annotation_excerpt",
      "original_text": "戊為山岡之土，非城牆之謂，較己土特高厚剛燥，乃己土之發源地也",
      "page": 11,
      "source_chunk_id": "DT2-0012",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-ji-verse",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "己土",
      "day_stem": "己",
      "kind": "verse",
      "original_text": "己土卑濕，中正蓄藏，不愁木盛，不畏水旺，火少火晦，金多金明，若要物昌，宜助宜幫。",
      "page": 11,
      "source_chunk_id": "DT2-0013",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-ji-annotation_excerpt",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "己土",
      "day_stem": "己",
      "kind": "annotation_excerpt",
      "original_text": "己為田園之土，其性卑濕，乃戊土枝葉之地，亦主中正，蓄藏萬物",
      "page": 12,
      "source_chunk_id": "DT2-0013",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-geng-verse",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "庚金",
      "day_stem": "庚",
      "kind": "verse",
      "original_text": "庚金帶煞，剛強為最，得水而清，得火而銳，土潤則生，土乾則脆，能勝甲兄，輸於乙妹。",
      "page": 12,
      "source_chunk_id": "DT2-0014",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-geng-annotation_excerpt",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "庚金",
      "day_stem": "庚",
      "kind": "annotation_excerpt",
      "original_text": "庚乃陽金，是太白之精，帶煞而剛健",
      "page": 12,
      "source_chunk_id": "DT2-0014",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-xin-verse",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "辛金",
      "day_stem": "辛",
      "kind": "verse",
      "original_text": "辛金軟弱，溫潤而清，畏土之疊，樂水之盈，能扶社稷，能救生靈，熱則喜母，寒則喜丁。",
      "page": 12,
      "source_chunk_id": "DT2-0015",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-xin-annotation_excerpt",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "辛金",
      "day_stem": "辛",
      "kind": "annotation_excerpt",
      "original_text": "辛乃陰金，非珠玉之謂，特溫柔清潤耳",
      "page": 13,
      "source_chunk_id": "DT2-0015",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-ren-verse",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "壬水",
      "day_stem": "壬",
      "kind": "verse",
      "original_text": "壬水汪洋，能洩金氣，剛中之德，周流不滯，通根透癸，沖天奔地，化則有情，從則相濟。",
      "page": 13,
      "source_chunk_id": "DT2-0016",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-ren-annotation_excerpt",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "壬水",
      "day_stem": "壬",
      "kind": "annotation_excerpt",
      "original_text": "壬乃癸水之源，有分有合，運行不息，為百川，亦為雨露，不可岐而二之",
      "page": 13,
      "source_chunk_id": "DT2-0016",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-gui-verse",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "癸水",
      "day_stem": "癸",
      "kind": "verse",
      "original_text": "癸水至弱，達於天津，龍德而運，功化斯神，不畏火土，不論庚辛，合戊化火，火根乃真。",
      "page": 14,
      "source_chunk_id": "DT2-0017",
      "stance_hint": "neutral"
    },
    {
      "entry_id": "dtjy-v1-gui-annotation_excerpt",
      "book_id": "ditiansui_jiyao",
      "chapter": "天干論",
      "section": "癸水",
      "day_stem": "癸",
      "kind": "annotation_excerpt",
      "original_text": "癸乃純陰而至弱，然上達天津",
      "page": 14,
      "source_chunk_id": "DT2-0017",
      "stance_hint": "neutral"
    }
  ]
}
